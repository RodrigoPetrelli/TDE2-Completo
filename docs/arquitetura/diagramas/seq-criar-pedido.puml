@startuml seq-criar-pedido
!include _estilo.iuml
skinparam defaultFontSize 14
skinparam ParticipantPadding 6
autonumber

title C4 Nível 4 — Sequência (UML): Criar pedido e notificar o restaurante

actor "Cliente\n(MFE Pedidos)" as Cliente
participant "API Gateway\n+ criar-pedido.http" as GW
participant "CriarPedido" as UC
participant "Réplicas locais\n(Clientes, Catálogo)" as Rep
participant "Pedido" as P <<aggregate>>
participant "Pedido\nRepositorio" as RPed
queue "Barramento\n(EventBridge)" as Bus
participant "Lambda\nNotificações" as NOT

Cliente -> GW : POST /api/pedidos
GW -> GW : x-request-id, rate limit
GW -> UC : executar(corpo)
UC -> UC : validar formato (400)
UC -> Rep : existe(clienteId)
UC -> Rep : obterRestaurante(id)
loop para cada item
  UC -> Rep : obterProduto(produtoId)
  Rep --> UC : ProdutoOfertado
end
note right of Rep : ausente -> 404
UC -> P : criar(linhas)
P -> P : regras (422),\nsubtotal + taxa 790
P --> UC : pedido CRIADO
UC -> RPed : salvar(pedido)
UC -> Bus : publicar(PedidoCriado)
Bus -->> NOT : entrega assíncrona
activate NOT
NOT -> NOT : NotificarNovoPedido\n(avisa restaurante via SNS)
deactivate NOT
UC --> GW : DadosPedido
GW --> Cliente : 201 Created
@enduml
